<% layout('layout') -%>

<div class="results-history">
  <h2>Your Test History</h2>
  
  <% if (results && results.length > 0) { %>
    <table>
      <thead>
        <tr>
          <th>Date</th>
          <th>WPM</th>
          <th>Accuracy</th>
          <th>Consistency</th>
          <th>Mode</th>
          <th>Details</th>
        </tr>
      </thead>
      <tbody>
        <% results.forEach(result => { %>
          <tr>
            <td><%= new Date(result.createdAt).toLocaleDateString() %></td>
            <td><%= result.wpm %></td>
            <td><%= result.accuracy %>%</td>
            <td><%= result.consistency %>%</td>
            <td><%= result.mode %></td>
            <td>
              <a href="#" class="btn btn-sm">View</a>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  <% } else { %>
    <p>No test results yet. Take a test to see your stats!</p>
  <% } %>
</div>